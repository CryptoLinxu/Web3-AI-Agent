# WalletConnect Project ID (从 https://cloud.walletconnect.com 获取)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id-here

# Supabase 配置 (从 Supabase 项目设置获取)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# 服务端密钥 (仅用于服务器端 API，勿泄露)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Solana RPC 配置（必填）
# ============================================
# 官方公共节点已限制访问（403 错误），需要使用以下免费 RPC 提供商：
#
# 选项 1: Helius (推荐，免费 100K 请求/月)
# 1. 访问 https://helius.dev 注册账号
# 2. 创建 API Key
# 3. 使用格式: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#
# 选项 2: Alchemy (免费 30M 请求/月)
# 1. 访问 https://alchemy.com 注册账号
# 2. 创建 Solana App
# 3. 使用格式: https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
#
# 选项 3: QuickNode (免费试用 7 天)
# 1. 访问 https://quicknode.com 注册账号
# 2. 创建 Solana Endpoint
# 3. 使用提供的 HTTP Provider URL
#
# 示例: NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=xxx-xxx-xxx
NEXT_PUBLIC_SOLANA_RPC_URL=

# ============================================
# 本地开发代理配置（可选，仅用于开发环境）
# ============================================
# 如果你使用 VPN 访问外部 API，需要配置代理
# 请将以下配置复制到 .env.local 文件中（不要提交到版本控制）
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
# 请检查你的 VPN 客户端获取正确的代理端口

